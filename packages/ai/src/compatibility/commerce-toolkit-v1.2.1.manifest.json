{
  "apiVersion": 1,
  "assetId": "builtin/commerce",
  "version": "1.2.1",
  "kind": "toolkit",
  "name": "店铺客服工具",
  "description": "随当前店铺自动使用拼多多、抖店或闲鱼能力；提供该平台可用的商品、视频、买家、历史和订单工具，无需为每家店单独配置。",
  "settingsFields": [],
  "members": [
    {
      "id": "send-product-card",
      "name": "发送商品卡片",
      "description": "使用本轮当前店铺商品查询返回的 productRef 发送原生商品卡片。只有 confirmed 才能说已发送，unknown 不得重试。",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "productRef": {
            "type": "string",
            "pattern": "^product:[0-9a-f-]{36}:\\d{1,3}$"
          }
        },
        "required": ["productRef"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["queued", "confirmed", "rejected", "unknown"]
          },
          "reasonCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "outboundId": {
            "type": "string"
          }
        },
        "required": ["status", "reasonCode", "message"],
        "additionalProperties": false
      },
      "requiresCapabilities": ["sendProductCard", "goods"],
      "requiresOperations": ["send-product-card"]
    },
    {
      "id": "send-video",
      "name": "发送店铺视频",
      "description": "使用本轮视频素材查询返回的 materialRef 给当前客户发送视频。仅发送与当前问题相关的素材；unknown 时不得重复发送。",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "materialRef": {
            "type": "string",
            "pattern": "^material:[0-9a-f-]{36}:\\d{1,3}$"
          }
        },
        "required": ["materialRef"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["queued", "confirmed", "rejected", "unknown"]
          },
          "reasonCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "outboundId": {
            "type": "string"
          }
        },
        "required": ["status", "reasonCode", "message"],
        "additionalProperties": false
      },
      "requiresCapabilities": ["sendVideo", "videoMaterials"],
      "requiresOperations": ["send-video"]
    },
    {
      "id": "invite-review",
      "name": "邀请评价",
      "description": "给当前客户发送抖店原生评价邀请卡片。使用本轮当前买家订单查询返回的 orderRef；仅在客户询问评价入口，或已确认收货/服务完成且适合邀请时使用，不在问候、投诉未解决或每轮回复时催评。同一订单不重复邀请；只有 confirmed 表示已发送，unknown 禁止重试。",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "orderRef": {
            "type": "string",
            "pattern": "^order:[0-9a-f-]{36}:\\d{1,3}$"
          }
        },
        "required": ["orderRef"],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["queued", "confirmed", "rejected", "unknown"]
          },
          "reasonCode": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "outboundId": {
            "type": "string"
          }
        },
        "required": ["status", "reasonCode", "message"],
        "additionalProperties": false
      },
      "requiresCapabilities": ["quickActions", "orders"],
      "requiresOperations": ["invite-review"]
    },
    {
      "id": "video-materials",
      "name": "店铺视频素材",
      "description": "查询当前店铺审核可用的视频素材，按需翻页。仅使用查询返回的 materialRef 发送视频。",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "pageSize": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "folderId": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "subjectId": {
            "type": "string"
          },
          "queriedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "partial": {
            "type": "boolean"
          },
          "failedSections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "section": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": ["section", "reason"],
              "additionalProperties": false
            }
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "evidenceRef": {
            "type": "string"
          },
          "fixture": {
            "type": "boolean"
          }
        },
        "required": ["operation", "queriedAt", "partial", "failedSections", "data", "evidenceRef"],
        "additionalProperties": false
      },
      "requiresCapabilities": ["videoMaterials"],
      "requiresOperations": ["video-materials"]
    },
