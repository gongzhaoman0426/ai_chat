{
  "name": "judesk",
  "version": "0.1.15",
  "description": "句达 · 本地 AI 客服工作台（开源 Demo）",
  "private": true,
  "type": "module",
  "main": "out/main/bootstrap.js",
  "author": "JuDesk",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm db:generate && pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/electron-smoke.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win --x64",
    "extensions:build": "node scripts/build-extensions.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "electron scripts/render-icons.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@mastra/core": "1.64.0",
    "@mastra/libsql": "1.22.3",
    "@mastra/memory": "1.28.2",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.0",
    "adm-zip": "^0.6.0",
    "ajv": "^8.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.5.0",
    "ws": "8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "^0.27.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
